---
pagination:
  data: projects
  size: 1
  alias: project
permalink: "projects/{{ project.slug }}/"
layout: "base.njk"
eleventyComputed:
  title: "{{ project.title }}"
---

<section class="container mt-1">

  {% if project.images.length %}
    <div class="image-gallery">
      {% for image in project.images %}
        <img src="{{ image.url }}?w=800&auto=format&fit=max" alt="{{ project.title }}" />
      {% endfor %}
    </div>
  {% endif %}

  <h1>{{ project.title }}</h1>

  <div class="project-content">
    {{ project.contentHtml | safe }}
  </div>

  <p><a href="/projects/">← Back to projects</a></p>

</section>
